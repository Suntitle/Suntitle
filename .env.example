# Compose overrides (use docker compose --env-file .env.local).
POSTGRES_DB=suntitle
POSTGRES_USER=suntitle
POSTGRES_PASSWORD=suntitle-local
APISERVER_ADVERTISE_ADDRESS=127.0.0.1
SERVICE_CIDR=10.96.0.0/12
REGISTRY_HOST=registry.localhost
# Host directory containing developers' local extension sources.
LOCAL_EXTENSIONS_DIR=./extensions

# Required to create the administrator on first API startup. Choose a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
